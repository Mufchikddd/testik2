# --- Источник данных -------------------------------------------------------
# tmdb | dracin | mock. Если не задано: tmdb (когда есть ключ), иначе mock.
DRAMA_PROVIDER=tmdb

# --- TMDB (рекомендуется) --------------------------------------------------
# Бесплатный ключ: https://www.themoviedb.org/settings/api
# Достаточно ЛИБО TMDB_API_KEY (v3), ЛИБО TMDB_READ_TOKEN (v4 Bearer).
TMDB_API_KEY=
TMDB_READ_TOKEN=
TMDB_LANGUAGE=ru-RU
# ko — корейские, zh — китайские, ja — японские
TMDB_ORIGINAL_LANGUAGE=ko
# Жанры, которые НЕ считаются дорамами (через запятую): реалити, ток-шоу, новости, документальные, детские.
# Чтобы показывать вообще всё — оставьте значение пустым.
TMDB_EXCLUDE_GENRES=10764,10767,10763,99,10762

# --- DracinAPI (экспериментальный адаптер) ---------------------------------
# Сверьте пути и заголовок авторизации с https://dracinapi.com/docs
DRACIN_API_KEY=
DRACIN_BASE_URL=https://dracinapi.com
DRACIN_PLATFORM=dramabox
DRACIN_FEED_PATH=/api/{platform}/feed
DRACIN_DETAIL_PATH=/api/{platform}/detail/{id}
DRACIN_AUTH_HEADER=x-api-key
DRACIN_AUTH_PREFIX=

# --- Кэш -------------------------------------------------------------------
# Время жизни данных в секундах (по умолчанию 6 часов)
CATALOG_TTL_SECONDS=21600
# Папка JSON-кэша (по умолчанию — временная папка ОС)
# CACHE_DIR=.cache

# --- Серии и плеер -----------------------------------------------------------
# Адрес JSON-файла студии со списком серий (только https). Без него работает тестовый набор.
EPISODES_FEED_URL=
# Хосты, с которых разрешено видео (через запятую; поддомены допускаются).
# Тестовый test-streams.mux.dev уберите перед запуском на боевых данных.
EPISODES_ALLOWED_HOSTS=le-vitation.tv,test-streams.mux.dev
# Как часто перечитывать JSON студии, в секундах (по умолчанию 5 минут)
EPISODES_TTL_SECONDS=300
